#!/usr/bin/env nu

const file_dir = (path self | path dirname)
const conf_dir = $"($nu.home-dir)/.config/pixiv-wallpaper"

use libpw

$env.PW_CACHEDIR = ($env.home)/.cache/pixiv-wallpaper

libpw init

$env.PW_INCLUDE_URLS = if (($conf_dir)/pw_include_urls.txt | path exists) { (open ($conf_dir)/pw_include_urls.txt | lines) } else { null }

$env.PW_BLACKLIST_IMAGES = if (($conf_dir)/pw_blacklist.txt | path exists) { (open ($conf_dir)/pw_blacklist.txt | lines) } else { null }

# fetch bookmarked images tagged with #wallpaper from pixiv using libpw
def main [
    --update-bookmarks (-u) # update the bookmarks cache
    --no-apply (-n) # don't apply wallpaper after updating bookmarks
    --verbose (-v) # print verbose output
    --print (-p) # print path instead of applying wallpaper
    --print-url (-l) # print url
    --show (-s) # print chosen image to terminal with chafa
    --next (-x): string # next wallpaper instead of random selection
    --all (-a) # just print all bookmarks
    --choose (-c): string # choose wallpaper directly
    --notify (-y) # send notification
] {
    let keys = (open ($env.home)/.config/pixiv-wallpaper/pw-keys.json)
    let access_token = libpw token access $keys.refresh_token

    if $update_bookmarks {
        libpw update-bookmarks $keys.user_id $access_token
        if $verbose {
            print -e "bookmarks updated !"
        }
    }

    let n_id = if $notify { notify-send "Pixiv Wallpaper" "Picking random wallpaper..." -p -t 999999 }
    
    if $all {
        print (libpw list-urls)
        exit
    }

    if $no_apply {
        if $verbose {
            print -e "exiting early..."
        }
        exit
    }

    let url = if $next != null { 
        let urls = libpw list-urls
        $urls | get (($urls | enumerate | where item == $next | get index).0 + 1)
    } else {
        if $choose != null {
            $choose
        } else {
            libpw pick-wallpaper 
        }
    }

    if $verbose {    
        print -e $"wallpaper selected: ($url)"
    }

    let wallpaper = libpw get-wallpaper $url $access_token
    if $verbose {
        $wallpaper | if ($in | get fetched) { print -e "wallpaper was fetched !" } else { print -e "wallpaper was in cache !" }
    }
    
    if $notify {
        notify-send -r $n_id "Pixiv Wallpaper" "Got wallpaper!" -t 2000 -e 
    }

    if $show {
        ^chafa $wallpaper.path
    }
    if $print {
        print $wallpaper.path
        exit
    }
    if $print_url {
        print $wallpaper.url
    }

    ^matugen image --quiet --source-color-index 0 $wallpaper.path out+err>| ignore
    if $verbose {
        print -e "wallpaper applied !"
    }
}
