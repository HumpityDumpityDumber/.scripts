#!/usr/bin/env nu

let state_file = $"($nu.home-dir)/.cache/monitor-input"

if not ($state_file | path exists) {
    "dp" | save $state_file
}

let current = (
    open $state_file
)

if $current == "dp" {
    ddcutil setvcp 0x60 0x06
    "hdmi" | save -f $state_file
} else {
    ddcutil setvcp 0x60 0x09
    "dp" | save -f $state_file
}
